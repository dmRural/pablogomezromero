---
import Layout from "../layouts/Layout.astro";
const services = ["Inversión y diversificación", "Ahorro, jubilación y protección", "Planificación financiera", "Hipoteca y liquidez", "Análisis patrimonial"];
const steps = [["01", "Entender tu situación", "Revisamos objetivos, patrimonio, ingresos y las decisiones que tienes delante."], ["02", "Diseñar una estrategia", "Ordenamos prioridades y construimos un plan que encaje con tu realidad."], ["03", "Seguir y ajustar", "Revisamos el camino para mantener la estrategia útil cuando cambien las circunstancias."]];
---
<Layout title="Asesoramiento financiero | Pablo Gómez Romero" description="Planificación financiera personal y patrimonial con un enfoque claro y cercano." structuredDataPage="finanzas">
  <main>
    <section class="border-b border-sky-100 bg-[#eff8fc] px-5 py-20"><div class="mx-auto max-w-6xl lg:px-8"><p class="eyebrow">Finanzas personales y patrimoniales</p><h1 class="display-title mt-5 max-w-3xl text-5xl sm:text-6xl">Ordena tus finanzas para decidir con más tranquilidad.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">Cada situación merece tiempo, contexto y una estrategia propia. Te ayudo a entenderla y decidir con criterio.</p><a class="btn-primary mt-8" href="https://wa.me/34659291511?text=Hola%20Pablo%2C%20quiero%20hablar%20sobre%20mi%20situaci%C3%B3n%20financiera" target="_blank" rel="noopener">Revisar mi situación financiera</a></div></section>
    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-20 lg:grid-cols-[.85fr_1.15fr] lg:px-8"><div><p class="eyebrow">En qué puedo ayudarte</p><h2 class="display-title mt-4 text-4xl">Tu dinero tiene que servir a tus objetivos.</h2><p class="mt-6 leading-7 text-slate-600">El asesoramiento parte de tu vida y de tus necesidades. No de una fórmula genérica.</p></div><div class="grid gap-3 sm:grid-cols-2">{services.map((service, i) => <div class="card flex items-center gap-4 p-5"><span class="text-sm font-bold text-sky-600">0{i + 1}</span><span class="font-bold text-[#0b1f3a]">{service}</span></div>)}</div></section>
    <section class="bg-white px-5 py-20"><div class="mx-auto max-w-6xl lg:px-8"><p class="eyebrow">El proceso</p><h2 class="display-title mt-4 max-w-xl text-4xl">Un método claro para tomar decisiones informadas.</h2><div class="mt-12 grid gap-8 md:grid-cols-3">{steps.map(([number, title, text]) => <div class="border-t-2 border-sky-500 pt-6"><span class="text-sm font-bold text-sky-600">{number}</span><h3 class="mt-5 font-serif text-2xl text-[#0b1f3a]">{title}</h3><p class="mt-3 leading-7 text-slate-600">{text}</p></div>)}</div></div></section>
    <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8"><div class="grid overflow-hidden rounded-[2rem] bg-[#0b1f3a] md:grid-cols-2"><img class="h-full min-h-80 w-full object-cover" src="/images/pablo-gomez-asesoria-financiera-1.png" alt="Asesoramiento financiero" /><div class="p-9 text-white sm:p-12"><p class="eyebrow !text-sky-300">Mi forma de trabajar</p><h2 class="mt-5 font-serif text-4xl leading-tight">Claridad, perspectiva de largo plazo y acompañamiento cercano.</h2><p class="mt-6 leading-7 text-slate-300">Hablamos de riesgos, liquidez, fiscalidad y rentabilidad con palabras comprensibles. La decisión siempre es tuya y debe estar bien entendida.</p><a class="mt-8 inline-block font-bold text-sky-300" href="https://wa.me/34659291511" target="_blank" rel="noopener">Cuéntame tu caso →</a></div></div></section>
  </main>
</Layout>
