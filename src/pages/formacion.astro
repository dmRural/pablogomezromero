---
import Layout from "../layouts/Layout.astro";
const formats = [["Talleres prácticos", "Para equipos y alumnado", "Conceptos útiles, ejercicios y recursos para aplicar desde el primer día."], ["Cursos a medida", "Para empresas y entidades", "Programas adaptados a un contexto, perfil de asistentes y objetivos concretos."], ["Conferencias", "Para eventos y asociaciones", "Una visión clara y accesible sobre economía, empresa y finanzas."]];
---
<Layout title="Formación en finanzas y empresa | Pablo Gómez Romero" description="Talleres, cursos y conferencias de finanzas y empresa para organizaciones, equipos y alumnado." structuredDataPage="formacion">
  <main>
    <section class="border-b border-sky-100 bg-[#eff8fc] px-5 py-20"><div class="mx-auto max-w-6xl lg:px-8"><p class="eyebrow">Formación para organizaciones</p><h1 class="display-title mt-5 max-w-3xl text-5xl sm:text-6xl">Formación que se entiende y se aplica.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">Sesiones, talleres y conferencias sobre economía, finanzas y empresa sin tecnicismos innecesarios.</p><a class="btn-primary mt-8" href="https://wa.me/34659291511?text=Hola%20Pablo%2C%20me%20interesa%20una%20formaci%C3%B3n" target="_blank">Diseñar una formación</a></div></section>
    <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8"><div class="max-w-2xl"><p class="eyebrow">Formatos</p><h2 class="display-title mt-4 text-4xl">El contenido se adapta a quien lo recibe.</h2></div><div class="mt-12 grid gap-4 lg:grid-cols-3">{formats.map(([title, audience, text], i) => <article class="card flex min-h-72 flex-col p-7"><span class="text-sm font-bold text-sky-600">0{i + 1}</span><h3 class="mt-9 font-serif text-3xl text-[#0b1f3a]">{title}</h3><p class="mt-3 text-sm font-bold text-sky-700">{audience}</p><p class="mt-5 leading-7 text-slate-600">{text}</p></article>)}</div></section>
    <section class="bg-white px-5 py-20"><div class="mx-auto grid max-w-6xl gap-7 lg:grid-cols-2 lg:px-8"><article class="border-t-2 border-sky-500 pt-7"><p class="eyebrow">Presencial</p><h2 class="mt-5 font-serif text-3xl text-[#0b1f3a]">Aprender haciendo y conversando.</h2><p class="mt-5 leading-7 text-slate-600">Educación financiera práctica, finanzas empresariales y economía aplicada para todos los niveles. La sesión se adapta a la experiencia y necesidades del grupo.</p></article><article class="border-t-2 border-sky-500 pt-7"><p class="eyebrow">Online</p><h2 class="mt-5 font-serif text-3xl text-[#0b1f3a]">Formación conectada con la realidad.</h2><p class="mt-5 leading-7 text-slate-600">Sesiones participativas que conectan conceptos con situaciones reales del entorno profesional, sin importar dónde esté el equipo.</p></article></div></section>
    <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8"><div class="grid overflow-hidden rounded-[2rem] bg-[#0b1f3a] md:grid-cols-2"><img class="h-full min-h-80 w-full object-cover" src="/images/pablo-gomez-asesoria-financiera-3.png" alt="Formación empresarial de Pablo Gómez Romero" /><div class="p-9 text-white sm:p-12"><p class="eyebrow !text-sky-300">Experiencia formativa</p><h2 class="mt-5 font-serif text-4xl leading-tight">Conocimiento para usarlo cuando de verdad importa.</h2><p class="mt-6 leading-7 text-slate-300">Colaboro con centros de estudios, escuelas de negocios, universidades, empresas y asociaciones para llevar el aprendizaje a situaciones concretas.</p><a class="mt-8 inline-block font-bold text-sky-300" href="https://wa.me/34659291511" target="_blank" rel="noopener">Hablemos de tu formación →</a></div></div></section>
  </main>
</Layout>
