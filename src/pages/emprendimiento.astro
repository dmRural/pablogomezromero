---
import Layout from "../layouts/Layout.astro";
const services = ["Puesta en marcha y viabilidad", "Plan de negocio y financiación", "Organización de recursos", "Digitalización de procesos", "Formación y liderazgo", "Alianzas y networking"];
const phases = [["01", "Analizamos", "Tu idea, el contexto y los retos que condicionan el proyecto."], ["02", "Priorizamos", "Objetivos realistas y medibles para que el esfuerzo vaya donde importa."], ["03", "Diseñamos", "Una hoja de ruta práctica adaptada a tus recursos y momento."], ["04", "Acompañamos", "Seguimiento para revisar avances y ajustar las decisiones."]];
---
<Layout title="Consultoría para emprendimiento y PYME | Pablo Gómez Romero" description="Estrategia, viabilidad y acompañamiento para emprendedores y pequeñas empresas." structuredDataPage="emprendimiento">
  <main>
    <section class="border-b border-sky-100 bg-[#eff8fc] px-5 py-20"><div class="mx-auto max-w-6xl lg:px-8"><p class="eyebrow">Emprendimiento y PYME</p><h1 class="display-title mt-5 max-w-3xl text-5xl sm:text-6xl">Convierte una buena idea en un proyecto sostenible.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">Desde la validación hasta el crecimiento, te acompaño a ordenar decisiones, recursos y prioridades.</p><a class="btn-primary mt-8" href="https://wa.me/34659291511?text=Hola%20Pablo%2C%20quiero%20impulsar%20mi%20proyecto" target="_blank">Impulsar mi proyecto</a></div></section>
    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-20 lg:grid-cols-[.85fr_1.15fr] lg:px-8"><div><p class="eyebrow">Acompañamiento estratégico</p><h2 class="display-title mt-4 text-4xl">Las buenas decisiones llegan antes que el crecimiento.</h2><p class="mt-6 leading-7 text-slate-600">Como fundador de DMRural, conozco los retos de emprender desde dentro. El trabajo se centra en acciones que puedas poner en marcha.</p></div><div class="grid gap-3 sm:grid-cols-2">{services.map((service, i) => <div class="card flex items-center gap-4 p-5"><span class="text-sm font-bold text-sky-600">0{i + 1}</span><span class="font-bold text-[#0b1f3a]">{service}</span></div>)}</div></section>
    <section class="bg-white px-5 py-20"><div class="mx-auto max-w-6xl lg:px-8"><p class="eyebrow">El recorrido</p><h2 class="display-title mt-4 max-w-2xl text-4xl">Un proceso para que el proyecto avance con dirección.</h2><div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-4">{phases.map(([number, title, text]) => <div class="border-t-2 border-sky-500 pt-6"><span class="text-sm font-bold text-sky-600">{number}</span><h3 class="mt-5 font-serif text-2xl text-[#0b1f3a]">{title}</h3><p class="mt-3 leading-7 text-slate-600">{text}</p></div>)}</div></div></section>
    <section class="bg-[#0b1f3a] px-5 py-20 text-center text-white"><p class="eyebrow !text-sky-300">Primera conversación</p><h2 class="mx-auto mt-4 max-w-2xl font-serif text-4xl leading-tight">Hablemos de dónde está tu proyecto y hacia dónde quieres llevarlo.</h2><a class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-bold text-[#075985]" href="https://wa.me/34659291511" target="_blank" rel="noopener">Cuéntame tu proyecto</a></section>
  </main>
</Layout>
